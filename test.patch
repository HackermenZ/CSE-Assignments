+void
+syscallinit(void)
+{
+  // Use pre-defined names instead of formatting with snprintf
+  char *locknames[] = {
+    "unused", "fork", "exit", "wait", "pipe", "read", "kill", "exec",
+    "fstat", "chdir", "dup", "getpid", "sbrk", "sleep", "uptime", "open",
+    "write", "mknod", "unlink", "link", "mkdir", "close", "history","settickets",
+    "getpinfo"};
+  
+  for(int i=1; i <= SYS_history; i++){
+    if(syscalls[i] != 0){
+      initlock(&syscall_stats[i].lock, locknames[i]);
+    }
+  }
+}
+
+
 // start() jumps here in supervisor mode on all CPUs.
 void
 main()
@@ -40,6 +60,7 @@ main()
     trapinithart();   // install kernel trap vector
     plicinithart();   // ask PLIC for device interrupts
   }
+  syscallinit();    // initialize system call statistics
 
   scheduler();        
 }
