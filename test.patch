+uint64
+sys_settickets(void)
+{
+  int n;
+  struct proc *p = myproc();
+  
+  argint(0, &n);
+  
+  if(n < 1) {
+    // Set default tickets if invalid number
+    acquire(&p->lock);
+    p->original_tickets = DEFAULT_TICKET_COUNT;
+    p->current_tickets = DEFAULT_TICKET_COUNT;
+    release(&p->lock);
+    return -1;
+  }
+  
+  acquire(&p->lock);
+  p->original_tickets = n;
+  p->current_tickets = n;
+  release(&p->lock);
+  
+  return 0;
+}
