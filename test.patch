+uint64
+sys_getpinfo(void)
+{
+  struct pstat ps;
+  uint64 addr;
+  struct proc *p;
+  
+  argaddr(0, &addr);
+  
+  // Initialize the pstat structure
+  for(int i = 0; i < NPROC; i++) {
+    ps.pid[i] = 0;
+    ps.inuse[i] = 0;
+    ps.inQ[i] = 0;
+    ps.tickets_original[i] = 0;
+    ps.tickets_current[i] = 0;
+    ps.time_slices[i] = 0;
+  }
+  
+  // Fill in the pstat structure - CORRECT INDEXING
+  int index = 0;  // Separate index for pstat arrays
+  for(p = proc; p < &proc[NPROC]; p++) {
+    acquire(&p->lock);
+    if(p->state != UNUSED && index < NPROC) {
+      ps.pid[index] = p->pid;
+      ps.inuse[index] = 1;
+      ps.inQ[index] = p->queue_number;
+      ps.tickets_original[index] = p->original_tickets;
+      ps.tickets_current[index] = p->current_tickets;
+      ps.time_slices[index] = p->time_slices_scheduled;
+      index++;  // Only increment when we store data
+    }
+    release(&p->lock);
+  }
+  
+  // Copy the pstat structure to user space
+  if(copyout(myproc()->pagetable, addr, (char *)&ps, sizeof(ps)) < 0) {
+    return -1;
+  }
+  
+  return 0;
+}
