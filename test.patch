+uint64
+sys_history(void)
+{
+  int syscall_num;
+  uint64 stat_addr;
+  struct syscall_stat stats;
+  
+  // Get arguments
+  argint(0, &syscall_num);
+  
+  // If syscall_num is 0, print all syscalls
+  if(syscall_num == 0) {
+    // Handle printing all syscalls from user space
+    return 0;
+  }
+  
+  // Check if syscall_num is valid
+  if(syscall_num < 0 || syscall_num >= NSYSCALLS || syscalls[syscall_num] == 0) {
+    return -1;
+  }
+  
+  // Get second argument - pointer to syscall_stat struct
+  argaddr(1, &stat_addr);
+  
+  // Fill in the stats
+  strncpy(stats.syscall_name, syscall_names[syscall_num], 15);
+  stats.syscall_name[15] = '\0';  // Ensure null termination
+  
+  // Get stats with proper locking
+  acquire(&syscall_stats[syscall_num].lock);
+  stats.count = syscall_stats[syscall_num].count;
+  stats.accum_time = syscall_stats[syscall_num].accum_time;
+  
+  // REMOVE THIS SPECIAL CASE - it's causing double counting
+  // if(syscall_num == SYS_history) {
+  //   syscall_stats[syscall_num].count++;
+  // }
+  
+  release(&syscall_stats[syscall_num].lock);
+  
+  // Copy the stats to user space
+  if(copyout(myproc()->pagetable, stat_addr, (char *)&stats, sizeof(stats)) < 0) {
+    return -1;
+  }
+  
+  return 0;
+}
